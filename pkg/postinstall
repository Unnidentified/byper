#!/bin/bash
# byper postinstall (vanilla branch): SUID CLI + symlinks + completions.
# Works no matter which bundle name the payload used (byper.app or
# byper-vanilla.app from older installers) so an upgrade over either
# variant never fails.
set -e

# Locate the freshly-installed app bundle (payload order: vanilla first).
APP_PATH=""
for CAND in /Applications/byper.app /Applications/byper-vanilla.app; do
    if [ -f "$CAND/Contents/Resources/byper" ]; then
        APP_PATH="$CAND"
        break
    fi
done
if [ -z "$APP_PATH" ]; then
    echo "postinstall: no installed byper app bundle found" >&2
    exit 1
fi

CLI_SRC="$APP_PATH/Contents/Resources/byper"
DEST="/usr/local/bin/byper"

mkdir -p /usr/local/bin
cp -f "$CLI_SRC" "$DEST"
chown root:wheel "$DEST"
chmod 4755 "$DEST"
codesign -s - -f "$DEST" >/dev/null 2>&1 || true
ln -sf "$DEST" /usr/local/bin/byp
ln -sf "$DEST" /usr/local/bin/chbypass

APP_RES="$APP_PATH/Contents/Resources"
mkdir -p /usr/local/share/zsh/site-functions /usr/local/share/bash-completion/completions
if [ -f "$APP_RES/completions/_byp" ]; then
    cp -f "$APP_RES/completions/_byp" /usr/local/share/zsh/site-functions/_byper
    cp -f "$APP_RES/completions/_byp" /usr/local/share/zsh/site-functions/_byp
fi
if [ -f "$APP_RES/completions/byp.bash" ]; then
    cp -f "$APP_RES/completions/byp.bash" /usr/local/share/bash-completion/completions/byper
    cp -f "$APP_RES/completions/byp.bash" /usr/local/share/bash-completion/completions/byp
fi

# Developer tools: the engine's lldb injection needs them. On a fresh Mac they
# are absent; install them silently now (no GUI prompt) so the first toggle works.
if ! xcode-select -p >/dev/null 2>&1; then
    LABEL=$(softwareupdate --list 2>/dev/null | awk -F'\\*' '/Command Line Tools/ {print $1}' | sed 's/^[[:space:]]*//' | head -1)
    if [ -n "$LABEL" ]; then
        echo "Installing developer tools (one-time, a few minutes)..."
        softwareupdate --install "$LABEL" --no-scan >/dev/null 2>&1 || true
    fi
fi

# Debugger permission: attaching lldb to system daemons requires DevToolsSecurity
# enabled + membership in the _developer group. Without this, debugserver denies
# the attach ("Not allowed to attach to process") on stock machines.
/usr/sbin/DevToolsSecurity -enable >/dev/null 2>&1 || true
GROUPMEMBER=$(stat -f %Su /dev/console)
if ! dscl . -read /Groups/_developer GroupMembership 2>/dev/null | grep -q "$GROUPMEMBER"; then
    dscl . -append /Groups/_developer GroupMembership "$GROUPMEMBER" >/dev/null 2>&1 || true
fi

rm -f /tmp/byp.state

# Open the freshly installed app for the user (install/upgrade only).
# LaunchAFterInstall: run as the console user, not root; skip on uninstall
# (the uninstall component's postinstall removes the app).
CONSOLE_USER=$(stat -f %Su /dev/console)
if [ "$CONSOLE_USER" != "root" ] && [ -d "$APP_PATH" ]; then
    launchctl asuser "$(id -u "$CONSOLE_USER")" sudo -u "$CONSOLE_USER" open "$APP_PATH" >/dev/null 2>&1 || true
fi
exit 0
