#!/bin/bash
# byper preinstall (UPGRADE path): remove all binaries/components but KEEP
# the app settings. Clean files in, configs preserved. The bypass state itself
# is reset to default (same as the uninstaller's hardware reset) so an upgrade
# never leaves the new build inheriting a stale hold. Handles both bundle
# names (byper.app and the older byper-vanilla.app) so an upgrade over
# either variant cleans up fully.
set -e

# ── Bypass state reset FIRST (while the CLI still exists) ──
# Release any bypass hold so the machine returns to stock charging before the
# old binary is deleted. Settings (defaults domain) stay untouched.
if [ -x /usr/local/bin/byper ]; then
    AC_ATTACHED=$(/usr/local/bin/byper json 2>/dev/null | grep -o '"acAttached": *true' || true)
    if [ -n "$AC_ATTACHED" ]; then
        /usr/local/bin/byper off >/dev/null 2>&1 || true
        sleep 1
        FLOW=$(/usr/local/bin/byper s 2>/dev/null | head -1)
        case "$FLOW" in
            *BYPASS*|*"ON HOLD"*|*"hold"*)
                /usr/local/bin/byper off >/dev/null 2>&1 || true
                ;;
        esac
    fi
fi
# The CLI binary may be non-SUID or absent while a hold persists in the PMU;
# a plain run of the new binary would still clear it, so also drop the CLI's
# persisted mode key: the new build boots with bypass off at the app level.
# Target the console user's domain: a pkg script runs as root, so a bare
# `defaults delete` would only touch root's domain and miss the real setting.
CONSOLE_USER=$(stat -f %Su /dev/console)
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
    CONSOLE_UID=$(id -u "$CONSOLE_USER" 2>/dev/null || true)
    if [ -n "$CONSOLE_UID" ]; then
        launchctl asuser "$CONSOLE_UID" sudo -u "$CONSOLE_USER" defaults delete com.gefaass.byper byp_power_mode 2>/dev/null || true
        launchctl asuser "$CONSOLE_UID" sudo -u "$CONSOLE_USER" defaults delete com.gefaass.byper byp_cached_hold 2>/dev/null || true
    fi
fi
defaults delete com.gefaass.byper byp_power_mode 2>/dev/null || true
defaults delete com.gefaass.byper byp_cached_hold 2>/dev/null || true

pkill -f "byper.app/Contents/MacOS/byper" 2>/dev/null || true
pkill -f "byper-vanilla.app/Contents/MacOS/byper" 2>/dev/null || true
sleep 1

rm -f  /usr/local/bin/byper /usr/local/bin/byp /usr/local/bin/chbypass
rm -f  /usr/local/bin/byper-mon.command /usr/local/bin/byp-mon.command
rm -f  /usr/local/bin/chbypass-service
rm -f  /usr/local/share/zsh/site-functions/_byper /usr/local/share/zsh/site-functions/_byp
rm -f  /usr/local/share/bash-completion/completions/byper /usr/local/share/bash-completion/completions/byp
rm -rf /Applications/byper.app /Applications/byp.app /Applications/byper-vanilla.app
rm -f  /Library/LaunchDaemons/com.gefaass.chbypass.plist
rm -f  /tmp/byp.state /tmp/byp_lldb.lock /tmp/byp_lldb_worker.log
rm -f  /tmp/byp_cmd_*.lldb 2>/dev/null || true

# Runtime state files are per uid: byp_app_caffeine.<uid>,
# byp_auto_run.<uid>.lock, byp_auto_run.<uid>.pid and byp_caffeine.<uid>.pid.
# Glob any uid, then keep only those four exact shapes, so a lookalike such as
# byp_caffeine.<uid>.pid.bak is left alone.
for path in /tmp/byp_app_caffeine.* /tmp/byp_auto_run.* /tmp/byp_caffeine.*; do
    [ -e "$path" ] || continue
    if [[ "$path" =~ ^/tmp/byp_(app_caffeine[.][0-9]+|auto_run[.][0-9]+[.](lock|pid)|caffeine[.][0-9]+[.]pid)$ ]]; then
        rm -f "$path"
    fi
done

# NOTE: app settings (defaults domain, caches) are intentionally KEPT on upgrade.

exit 0
