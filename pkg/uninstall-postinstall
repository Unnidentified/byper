#!/bin/bash
# byper UNINSTALL postinstall: reset the hardware to stock, then remove every
# trace of byper on this Mac: the app, the SUID CLI and symlinks, completions,
# legacy daemon, temp state, and all app settings.
set -e

# ── 1. Hardware reset FIRST (while the CLI still exists) ──
# Release any bypass hold and restore normal charging: the machine must return
# to stock power behavior before the tool that could undo it is deleted.
if [ -x /usr/local/bin/byper ]; then
    AC_ATTACHED=$(/usr/local/bin/byper json 2>/dev/null | grep -o '"acAttached": *true' || true)
    if [ -n "$AC_ATTACHED" ]; then
        /usr/local/bin/byper off >/dev/null 2>&1 || true
        sleep 1
        FLOW=$(/usr/local/bin/byper s 2>/dev/null | head -1)
        case "$FLOW" in
            *BYPASS*|*"ON HOLD"*)
                /usr/local/bin/byper off >/dev/null 2>&1 || true
                ;;
        esac
    fi
    # Also clear LPM so every power knob byper may have touched is back to stock.
    /usr/local/bin/byper lpm off >/dev/null 2>&1 || true
    /usr/bin/pmset -a lowpowermode 0 >/dev/null 2>&1 || true
    # The lid switch is a stored setting, not an assertion, so it outlives the
    # process that set it. Clear it while the CLI still exists.
    /usr/local/bin/byper lid off >/dev/null 2>&1 || true
fi

# Kill any stale byper lldb worker from a previous session before removing
# state. Match byper's own script path, not the substring "lldb": the old
# `pkill -f lldb` killed unrelated developer debugging sessions too.
pkill -f "byp_cmd_" 2>/dev/null || true
pkill -f "byper.app/Contents/MacOS/byper" 2>/dev/null || true
sleep 1

# ── 2. Remove binaries, app, state ──
rm -f  /usr/local/bin/byper /usr/local/bin/byp /usr/local/bin/chbypass
rm -f  /usr/local/bin/byper-mon.command /usr/local/bin/byp-mon.command
rm -f  /usr/local/bin/chbypass-service
rm -f  /usr/local/share/zsh/site-functions/_byper /usr/local/share/zsh/site-functions/_byp
rm -f  /usr/local/share/bash-completion/completions/byper /usr/local/share/bash-completion/completions/byp
rm -rf /Applications/byper.app /Applications/byp.app /Applications/byper-vanilla.app
rm -f  /Library/LaunchDaemons/com.gefaass.chbypass.plist
rm -f  /tmp/byp.state /tmp/byp_lldb.lock /tmp/byp_lldb_worker.log
rm -f  /tmp/byp_cmd_*.lldb 2>/dev/null || true

# Runtime state files are per uid: byp_app_caffeine.<uid>,
# byp_auto_run.<uid>.lock, byp_auto_run.<uid>.pid and byp_caffeine.<uid>.pid.
# Glob any uid, then keep only those four exact shapes, so a lookalike such as
# byp_caffeine.<uid>.pid.bak is left alone.
for path in /tmp/byp_app_caffeine.* /tmp/byp_auto_run.* /tmp/byp_caffeine.*; do
    [ -e "$path" ] || continue
    if [[ "$path" =~ ^/tmp/byp_(app_caffeine[.][0-9]+|auto_run[.][0-9]+[.](lock|pid)|caffeine[.][0-9]+[.]pid)$ ]]; then
        rm -f "$path"
    fi
done

# ── 3. Remove settings ──
# A pkg postinstall runs as root with HOME=/var/root, so the old `defaults
# delete` and $HOME removals only touched root's domain and left the real
# user's settings behind. Resolve the console user and remove theirs.
CONSOLE_USER=$(stat -f %Su /dev/console)
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
    CONSOLE_UID=$(id -u "$CONSOLE_USER" 2>/dev/null || true)
    CONSOLE_HOME=$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | sed -n 's/^NFSHomeDirectory: //p')
    if [ -n "$CONSOLE_UID" ]; then
        launchctl asuser "$CONSOLE_UID" sudo -u "$CONSOLE_USER" defaults delete com.gefaass.byper 2>/dev/null || true
    fi
    if [ -n "$CONSOLE_HOME" ]; then
        rm -f  "$CONSOLE_HOME/Library/Preferences/com.gefaass.byper.plist"
        rm -rf "$CONSOLE_HOME/Library/Saved Application State/com.gefaass.byper.savedState"
        rm -rf "$CONSOLE_HOME/Library/Caches/com.gefaass.byper"
        rm -rf "$CONSOLE_HOME/Library/HTTPStorages/com.gefaass.byper"
    fi
fi
defaults delete com.gefaass.byper 2>/dev/null || true
killall cfprefsd 2>/dev/null || true

# NOTE: the install enabled DevToolsSecurity and added the console user to
# _developer. Those are left in place on uninstall so a developer's other tools
# keep working; revert manually if desired:
#   sudo DevToolsSecurity -disable
#   sudo dscl . -delete /Groups/_developer GroupMembership <user>

# ── 4. Forget the receipts LAST ──
# Forget only after the files are gone: a receipt dropped while its files
# survive leaves pkgutil with no record of what is still on disk. pkgutil
# --forget exits non-zero when the receipt is already absent, which is the
# normal case on a second run, so each call is best effort.
for receipt in com.gefaass.byper com.gefaass.byper.uninstall; do
    /usr/sbin/pkgutil --forget "$receipt" >/dev/null 2>&1 || true
done

exit 0
