<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>byper 3.5.0</title>
    <organization>com.gefaass</organization>
    <options customize="always" require-scripts="true"/>
    <domains enable_anywhere="true" enable_currentUserHome="false" enable_localSystem="true"/>
    <welcome file="Welcome.rtf"/>
    <license file="License.rtf"/>
    <choices-outline>
        <line choice="byperApp"/>
    </choices-outline>
    <choice id="byperApp" title="byper - Charge Bypass and Telemetry" description="Installs byper.app, the SUID-root CLI (byper/byp/chbypass) and shell completions. Running this installer over an existing installation performs a complete uninstall first.">
        <pkg-ref id="com.gefaass.byper"/>
    </choice>
    <pkg-ref id="com.gefaass.byper" onConclusion="none">byper-pkg-component.pkg</pkg-ref>
</installer-gui-script>
